# tok — environment variables
#
# Copy this file to `.env` and fill in the keys you need. `tok` does NOT
# auto-load `.env` — export the variables yourself (e.g. via `set -a; source .env; set +a`)
# or rely on your shell/tool of choice.

# --- Anthropic (Claude) -------------------------------------------------------
# REQUIRED for any `tok anthropic/<model>` invocation.
# Without this key, the CLI prints an error and exits 1.
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google (Gemini) ----------------------------------------------------------
# REQUIRED ONLY when the local tokenizer cannot handle the requested model
# (e.g. gemini-3.1-pro-preview). Locally-supported models like
# gemini-1.5-pro / gemini-2.5-flash run offline without any key.
# Either GEMINI_API_KEY or GOOGLE_API_KEY works; if both are set,
# GOOGLE_API_KEY takes precedence (mirrors the genai SDK's own rule).
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- HuggingFace --------------------------------------------------------------
# OPTIONAL for public models. REQUIRED for private models, and recommended
# to avoid HuggingFace API rate-limits during autocomplete (`<org>/<TAB>`).
# Get one: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- OpenAI -------------------------------------------------------------------
# NOT required. `tok openai/<model>` uses the local tiktoken-go tokenizer
# and never makes a network call. Setting this variable has no effect.
